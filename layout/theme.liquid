<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {%- if request.page_type == 'index' -%}
      Voltrix — Suplemento 4 en 1: Hidratación, Energía, Foco y Recuperación
    {%- else -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- endif -%}
  </title>

  {% if request.page_type == 'index' %}
    <meta name="description" content="Voltrix combina creatina, electrolitos, cafeína con L-teanina y KSM-66® en una sola toma diaria. 1,67€/día — hidratación real, energía sin crash, foco sostenido y recuperación completa. Sin complicarte con cuatro botes distintos.">
  {% elsif page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="{{ shop.description | default: 'Voltrix: hidratación real, energía limpia, foco mental y recuperación completa en una sola toma diaria.' | escape }}">
  {% endif %}

  {% comment %} ── Open Graph (Facebook, WhatsApp, LinkedIn...) ── {% endcomment %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{% if request.page_type == 'index' %}Voltrix — Hidratación, Energía, Foco y Recuperación en una sola toma{% else %}{{ page_title | escape }}{% endif %}">
  <meta property="og:description" content="{% if request.page_type == 'index' %}Creatina, electrolitos, foco y recuperación en un solo bote. 1,67€/día — lo que cuesta tu café de las 9.{% else %}{{ page_description | default: shop.description | escape }}{% endif %}">
  <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
  {% if page_image %}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  {% elsif settings.social_share_image %}
    <meta property="og:image" content="https:{{ settings.social_share_image | image_url: width: 1200 }}">
  {% else %}
    <meta property="og:image" content="https:{{ 'logo-voltrix-og.png' | asset_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
  {% endif %}

  {% comment %} ── Twitter Card ── {% endcomment %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if request.page_type == 'index' %}Voltrix — Hidratación, Energía, Foco y Recuperación en una sola toma{% else %}{{ page_title | escape }}{% endif %}">
  <meta name="twitter:description" content="{% if request.page_type == 'index' %}Creatina, electrolitos, foco y recuperación en un solo bote. 1,67€/día — lo que cuesta tu café de las 9.{% else %}{{ page_description | default: shop.description | escape }}{% endif %}">
  {% if page_image %}
    <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {% else %}
    <meta name="twitter:image" content="https:{{ 'logo-voltrix-og.png' | asset_url }}">
  {% endif %}

  {% comment %} ── JSON-LD: Organization (aparece en todas las páginas) ── {% endcomment %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ shop.name }}",
    "url": "{{ shop.url }}",
    "logo": "https:{{ 'logo-voltrix.png' | asset_url }}"
  }
  </script>

  {{ content_for_header }}

  <!-- Fuentes de marca: Inter (body) + DM Serif Display (titulares) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=DM+Serif+Display:ital@0;1&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=DM+Serif+Display:ital@0;1&display=swap"></noscript>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  <noscript><style>.vx-reveal{opacity:1!important;transform:none!important}</style></noscript>
  <link rel="icon" type="image/png" href="{{ 'favicon-voltrix.png' | asset_url }}">
</head>
<body{% if request.path contains '/apps/subscriptions' %} class="vx-portal"{% endif %}>
  {% sections 'header-group' %}
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
</body>
</html>
