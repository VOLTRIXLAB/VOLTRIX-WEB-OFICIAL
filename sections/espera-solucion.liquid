  .vx-es__item { padding: 28px 26px; background: rgba(255,255,255,.02); border-right: 1px solid #1E1E38; border-bottom: 1px solid #1E1E38; }
  .vx-es__item:nth-child(2n) { border-right: none; }
  .vx-es__item:nth-child(3), .vx-es__item:nth-child(4) { border-bottom: none; }
