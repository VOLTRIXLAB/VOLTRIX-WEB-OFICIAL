  @media (max-width: 700px) { .vx-es { padding: 56px 16px; } .vx-es__grid { grid-template-columns: 1fr; } .vx-es__item { border-right: none; border-bottom: 1px solid #1E1E38 !important; } .vx-es__item:last-child { border-bottom: none !important; } }
</style>
