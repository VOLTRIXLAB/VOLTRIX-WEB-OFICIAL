<section class="vx-cmp section--dark page-width" id="comparativa">
  <p class="vx-eyebrow text-volt">La comparación</p>
  <h2 class="font-display vx-reveal">Cuatro botes<br>o una cucharada.</h2>
  <p class="vx-cmp__sub vx-reveal" data-vx-delay="1">La misma química, sin montar tu propio puzzle.</p>

  <div class="vx-cmp__table vx-reveal" data-vx-delay="2" role="table" aria-label="Comparación entre Voltrix y comprar los ingredientes por separado">
    <div class="vx-cmp__row vx-cmp__row--head" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="columnheader"><span class="vx-cmp__sr">Concepto</span></div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="columnheader">Voltrix</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="columnheader">Comprar los 4 por separado</div>
    </div>

    <div class="vx-cmp__row" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Tomas al día</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix">1 cucharada (8,5 g)</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">3–4 productos distintos</div>
    </div>
    <div class="vx-cmp__row" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Creatina</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix">3.000 mg monohidrato Creapure®</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">La dosis que tú elijas</div>
    </div>
    <div class="vx-cmp__row" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Electrolitos</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix">Sodio 600 mg · Potasio 300 mg · Mg bisglicinato 100 mg</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">Tienes que combinarlos y dosificarlos tú</div>
    </div>
    <div class="vx-cmp__row" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Foco</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix">L-teanina Suntheanine® 200 mg + cafeína 100 mg (ratio 2:1)</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">El ratio depende de cuánto café y cuánta teanina compres</div>
    </div>
    <div class="vx-cmp__row" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Estrés</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix">KSM-66® 300 mg</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">Otro bote, otra dosis</div>
    </div>
    <div class="vx-cmp__row" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Taurina</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix">500 mg incluida</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">Otro bote más</div>
    </div>
    <div class="vx-cmp__row" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Sabor</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix">Limón/lima, sin azúcar</div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">Distinto en cada producto</div>
    </div>
    <div class="vx-cmp__row vx-cmp__row--price" role="row">
      <div class="vx-cmp__cell vx-cmp__cell--label" role="rowheader">Precio al mes</div>
      <div class="vx-cmp__cell vx-cmp__cell--us" role="cell" data-label="Voltrix"><strong>49,99€</strong> <span>(1,67€/día)</span></div>
      <div class="vx-cmp__cell vx-cmp__cell--them" role="cell" data-label="Por separado">Entre 60 y 90€*</div>
    </div>
  </div>

  <p class="vx-cmp__fine">*Rango aproximado de la suma de productos equivalentes de marca. Comparación orientativa: los precios de productos sueltos varían según marca y tienda.</p>
  <a href="#producto" class="vx-cmp__cta">Empezar con Voltrix →</a>
</section>
<style>
  .vx-cmp { padding: 88px 24px; }
  .vx-cmp h2 { font-size: clamp(28px, 3.8vw, 48px); line-height: 1.1; letter-spacing: -.4px; margin-bottom: 12px; }
  .vx-cmp__sub { font-size: 16px; color: rgba(255,255,255,.5); max-width: 500px; line-height: 1.72; margin-bottom: 40px; }
  .vx-cmp__table { border: 1px solid #1E1E38; border-radius: 20px; overflow: hidden; background: rgba(255,255,255,.02); }
  .vx-cmp__row { display: grid; grid-template-columns: 1.1fr 1.5fr 1.3fr; border-bottom: 1px solid #1E1E38; }
  .vx-cmp__row:last-child { border-bottom: none; }
  .vx-cmp__cell { padding: 18px 22px; font-size: 14px; line-height: 1.5; color: rgba(255,255,255,.5); }
  .vx-cmp__cell--label { font-weight: 800; color: var(--color-white); }
  .vx-cmp__cell--us { background: rgba(200,241,53,.06); color: var(--color-white); border-left: 1px solid rgba(200,241,53,.25); border-right: 1px solid rgba(200,241,53,.25); }
  .vx-cmp__row--head .vx-cmp__cell { font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,.4); padding-top: 20px; padding-bottom: 20px; }
  .vx-cmp__row--head .vx-cmp__cell--us { color: var(--color-ink); background: var(--color-volt); border-left-color: var(--color-volt); border-right-color: var(--color-volt); }
  .vx-cmp__row--price .vx-cmp__cell { font-size: 15px; }
  .vx-cmp__row--price .vx-cmp__cell--us strong { font-size: 20px; font-family: var(--font-display); font-weight: 400; color: var(--color-volt); }
  .vx-cmp__row--price .vx-cmp__cell--us span { font-size: 12px; color: rgba(255,255,255,.55); }
  .vx-cmp__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .vx-cmp__fine { font-size: 11.5px; color: rgba(255,255,255,.3); line-height: 1.6; margin: 14px 4px 0; max-width: 640px; }
  .vx-cmp__cta { display: inline-block; margin-top: 28px; padding: 15px 28px; border-radius: 10px; background: var(--color-volt); color: var(--color-ink); font-size: 14px; font-weight: 800; text-decoration: none; }
  .vx-cmp__cta:hover { opacity: .9; }
  @media (max-width: 700px) {
    .vx-cmp { padding: 64px 20px; }
    .vx-cmp__row { grid-template-columns: 1fr 1fr; }
    .vx-cmp__row--head { grid-template-columns: 1fr 1fr; }
    .vx-cmp__row--head .vx-cmp__cell--label { display: none; }
    .vx-cmp__row .vx-cmp__cell--label { grid-column: 1 / -1; padding: 14px 16px 2px; font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,.4); }
    .vx-cmp__cell { padding: 6px 16px 16px; font-size: 13px; }
    .vx-cmp__row--head .vx-cmp__cell { padding: 14px 16px; font-size: 10px; }
    .vx-cmp__cell--us { border-left: none; border-right: 1px solid rgba(200,241,53,.25); }
    .vx-cmp__row--head .vx-cmp__cell--us { border-right-color: var(--color-volt); }
  }
</style>
{% schema %}
{ "name": "Comparativa", "settings": [] }
{% endschema %}
