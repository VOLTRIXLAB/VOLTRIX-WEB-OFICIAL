<style>
  .vx-proof { padding: 18px 24px; border-top: 1px solid #1E1E38; border-bottom: 1px solid #1E1E38; background: #0F0F24; }
  .vx-proof__inner { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px; }
  .vx-proof__item { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: rgba(255,255,255,.55); white-space: nowrap; }
  .vx-proof__item svg { color: var(--color-volt); flex-shrink: 0; }
  .vx-proof__sep { width: 1px; height: 14px; background: #28284A; }
</style>
