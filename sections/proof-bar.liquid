<section class="vx-proof section--dark">
  <div class="page-width vx-proof__inner">
    <div class="vx-proof__item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span>4 complejos en 1</span>
    </div>
    <div class="vx-proof__sep"></div>
    <div class="vx-proof__item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg>
      <span>3.000mg de creatina</span>
    </div>
    <div class="vx-proof__sep"></div>
    <div class="vx-proof__item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>KSM-66® patentado</span>
    </div>
    <div class="vx-proof__sep"></div>
    <div class="vx-proof__item">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>30 porciones</span>
    </div>
  </div>
</section>
<style>
  .vx-proof { padding: 18px 24px; border-top: 1px solid #1E1E38; border-bottom: 1px solid #1E1E38; background: #0F0F24; }
  .vx-proof__inner { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px; }
  .vx-proof__item { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: rgba(255,255,255,.55); white-space: nowrap; }
  .vx-proof__item svg { color: var(--color-volt); flex-shrink: 0; }
  .vx-proof__sep { width: 1px; height: 14px; background: #28284A; }
  @media (max-width: 600px) { .vx-proof__sep:nth-of-type(3) { display: none; } }
</style>
{% schema %}
{ "name": "Proof Bar", "settings": [] }
{% endschema %}
