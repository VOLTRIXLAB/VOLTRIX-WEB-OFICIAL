{%- liquid
  assign a = section.settings.angle

  case a
    when 'energia'
      assign eyebrow = 'Energía y foco'
      assign h1_a = 'El café de las 9 ya no'
      assign h1_b = 'te despierta igual.'
      assign sub = 'Cafeína de 100 mg con L-teanina de 200 mg en ratio 2:1, en una sola toma. Pensada para que la cafeína no vaya sola.'
      assign problemas = 'Te tomas el café a las 9 y a las 11 ya necesitas otro.|Llegas a la reunión de las 4 con la cabeza a medias.|Cada vez más café y cada vez menos efecto.' | split: '|'
      assign why_title = 'La cafeína sola es solo una parte'
      assign why_text = 'Por eso Voltrix combina 100 mg de cafeína natural con 200 mg de L-teanina pura, en ratio 2:1. Una toma, a la hora de tu café, y sin azúcar.'
      assign ings = 'Cafeína natural::100 mg::Ayuda a aumentar el estado de alerta y a mejorar la concentración.|L-teanina (100 % pura)::200 mg::Va junto a la cafeína en ratio 2:1, para que no vaya sola.' | split: '|'
      assign agit1 = 'Primero fue un café. Luego dos. Ahora el café de las 9 ya no marca la diferencia y a las 3 estás buscando otro.'
      assign agit2 = 'El problema no es que necesites más cafeína. Es cómo la tomas: sola, con prisa y sin nada que la acompañe.'
      assign sol_title = 'Cafeína, pero no sola'
      assign sol_text = 'Voltrix lleva el Focus & Energy Complex: 100 mg de cafeína natural y 200 mg de L-teanina pura en ratio 2:1, una combinación pensada para acompañar a la cafeína. Es tu café de las 9, con una fórmula detrás y sin azúcar.'
      assign active = 'focus'
    when 'estres'
      assign eyebrow = 'Estrés y recuperación'
      assign h1_a = 'Terminas el día agotado'
      assign h1_b = 'y aun así no desconectas.'
      assign sub = 'Jornadas de 10 horas, estrés acumulado y entrenos que no terminas de recuperar. Voltrix suma KSM-66® (300 mg) y magnesio bisglicinato a tu rutina diaria.'
      assign problemas = 'Sales del trabajo y la cabeza sigue en el trabajo.|Entrenas 4 veces por semana y notas que no te recuperas entre sesiones.|El domingo por la noche ya estás pensando en el lunes.' | split: '|'
      assign why_title = 'No se arregla con fuerza de voluntad'
      assign why_text = 'El estrés se acumula y se nota en el entreno, en el sueño y en la cabeza. Lo que sí controlas es la rutina: una toma al día, a la misma hora, con ingredientes en dosis definida.'
      assign ings = 'KSM-66® Ashwagandha::300 mg::Extracto estandarizado de raíz de ashwagandha.|Magnesio bisglicinato::100 mg::Contribuye a reducir el cansancio y la fatiga, y al funcionamiento psicológico normal.' | split: '|'
      assign agit1 = 'Trabajas 10 horas, entrenas cuatro veces por semana y duermes lo que puedes. Haces todo bien y aun así llegas al final del día sin ganas de nada.'
      assign agit2 = 'No es pereza ni falta de disciplina. Es acumulación. Y la acumulación no se arregla con una semana buena.'
      assign sol_title = 'Una rutina fija que sostiene lo demás'
      assign sol_text = 'Voltrix lleva el Stress & Recovery Complex: 300 mg de KSM-66®, un extracto estandarizado de raíz de ashwagandha. Y dentro del Hydra Performance Complex, 100 mg de magnesio bisglicinato, que contribuye a reducir el cansancio y la fatiga. No es un atajo: es una toma diaria con hidratación, foco y rendimiento incluidos.'
      assign active = 'stress'
    when 'rendimiento'
      assign eyebrow = 'Rendimiento'
      assign h1_a = 'Llevas semanas con los mismos pesos.'
      assign h1_b = 'No es la rutina.'
      assign sub = '3 g de creatina monohidrato al día, la dosis habitual de los estudios, y 500 mg de taurina, en una sola toma.'
      assign problemas = 'Mismos kilos en la barra desde hace semanas.|Última serie con la sensación de que podías más.|Cumples el plan al 100 % y la barra no se mueve.' | split: '|'
      assign why_title = 'La dosis importa. La constancia, más.'
      assign why_text = 'La creatina funciona cuando la tomas todos los días, no solo los días que entrenas. Por eso una dosis útil de 3 g va en la misma toma de siempre, con el resto de la fórmula.'
      assign ings = 'Creatina monohidrato::3 g::Aumenta el rendimiento físico en series sucesivas de ejercicios de corta duración y alta intensidad (3 g al día, adultos).|Taurina::500 mg::Aminoácido que completa la fórmula de rendimiento.' | split: '|'
      assign agit1 = 'Mismo plan, mismas series, mismos pesos. Entrenas bien y la barra sigue en el mismo sitio.'
      assign agit2 = 'La creatina es una de las más estudiadas, y aun así mucha gente la toma a ratos, en dosis a medias o solo los días de gimnasio.'
      assign sol_title = 'La dosis útil, todos los días'
      assign sol_text = 'Voltrix lleva el Performance Complex: 3 g de creatina monohidrato y 500 mg de taurina en cada toma. Va en el bote para que la dosis no dependa de que te acuerdes de medirla: una cucharada y listo.'
      assign active = 'perf'
    else
      assign a = 'hidratacion'
      assign eyebrow = 'Hidratación'
      assign h1_a = 'Bebes 2 litros al día'
      assign h1_b = 'y sigues con sed.'
      assign sub = 'No es falta de agua. Es falta de electrolitos en dosis útil. Sodio, potasio y magnesio bisglicinato, en una sola toma.'
      assign problemas = 'A media tarde ya llevas la botella vacía y la boca seca.|Entrenas, sudas y terminas la sesión con la sensación de ir vacío.|Cambias de bebida cada mes y ninguna se queda en tu rutina.' | split: '|'
      assign why_title = 'El agua sola no hace todo el trabajo'
      assign why_text = 'Cuando sudas pierdes agua y sales minerales, y reponer solo el agua se queda a medias. Aquí no hay dosis simbólicas: cada toma lleva 600 mg de sodio, 300 mg de potasio y 100 mg de magnesio bisglicinato.'
      assign ings = 'Sodio (citrato sódico)::600 mg::El electrolito principal que pierdes con el sudor.|Potasio (citrato potásico)::300 mg::Contribuye al funcionamiento normal de los músculos y del sistema nervioso.|Magnesio bisglicinato::100 mg::Contribuye al equilibrio electrolítico y a reducir el cansancio y la fatiga.' | split: '|'
      assign agit1 = 'Te acuerdas de beber cuando llevas horas sin hacerlo, rellenas la botella tres veces y aun así llegas a la tarde con la boca seca.'
      assign agit2 = 'Entrenas, sudas y repones solo agua. Los minerales que pierdes con el sudor se quedan sin reponer, y muchas bebidas deportivas llevan azúcar y poco más.'
      assign sol_title = 'Lo que el agua sola no repone'
      assign sol_text = 'Voltrix lleva el Hydra Performance Complex: sodio, potasio y magnesio bisglicinato en dosis que no son simbólicas, y sin azúcar. La idea no es beber más; es que lo que bebes venga acompañado de lo que tu cuerpo usa.'
      assign active = 'hydra'
  endcase
-%}

<section class="vx-ang section--dark" data-vx-angulo="{{ a }}">
  <div class="vx-ang__hero">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">{{ eyebrow }}</p>
      <h1 class="font-display">
        <span class="vx-rise-line"><span>{{ h1_a }}</span></span>
        <span class="vx-rise-line"><span><em>{{ h1_b }}</em></span></span>
      </h1>
      <p class="vx-ang__sub">{{ sub }}</p>
      <a href="#producto" class="vx-ang__cta">Ver Voltrix · 49,99 € →</a>
      <p class="vx-ang__meta">255 g · 30 tomas · 1,67 € al día · Sin azúcar · Limón/lima</p>
    </div>
  </div>

  <div class="vx-ang__block">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">¿Te suena?</p>
      <ul class="vx-ang__list">
        {%- for p in problemas -%}
          <li class="vx-reveal" data-vx-delay="{{ forloop.index }}">{{ p }}</li>
        {%- endfor -%}
      </ul>
      <p class="vx-ang__why vx-reveal">{{ agit1 }}</p>
      <p class="vx-ang__why vx-reveal">{{ agit2 }}</p>
      <p class="vx-ang__mono vx-reveal">Y por la noche, la misma frase: <em>«mañana lo hago mejor».</em></p>
    </div>
  </div>

  <div class="vx-ang__block vx-ang__block--alt">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">Por qué pasa</p>
      <h2 class="font-display vx-reveal">{{ why_title }}</h2>
      <p class="vx-ang__why vx-reveal" data-vx-delay="1">{{ why_text }}</p>
      <div class="vx-ang__ings">
        {%- for i in ings -%}
          {%- assign parts = i | split: '::' -%}
          <div class="vx-ang__ing vx-reveal" data-vx-delay="{{ forloop.index }}">
            <div class="vx-ang__dose">{{ parts[1] }}</div>
            <div class="vx-ang__ing-name">{{ parts[0] }}</div>
            <div class="vx-ang__ing-desc">{{ parts[2] }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="vx-ang__block">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">La solución</p>
      <h2 class="font-display vx-reveal">{{ sol_title }}</h2>
      <p class="vx-ang__why vx-reveal" data-vx-delay="1">{{ sol_text }}</p>
      <ol class="vx-ang__steps">
        <li class="vx-reveal" data-vx-delay="1"><b>Una cucharada.</b> El bote lleva su medidor: 8,5 g en 200 ml de agua. Sabor limón/lima y sin azúcar.</li>
        <li class="vx-reveal" data-vx-delay="2"><b>A la misma hora cada día.</b> La clave es la constancia. Por la mañana, a la hora de tu café, es lo más fácil de mantener. Contiene 100 mg de cafeína.</li>
        <li class="vx-reveal" data-vx-delay="3"><b>Un mes para juzgarlo.</b> Un bote son 30 tomas. Sin prisas ni promesas de 48 horas: lo pruebas con tu rutina y decides tú.</li>
      </ol>
    </div>
  </div>

  <div class="vx-ang__block vx-ang__block--alt">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">La fórmula completa</p>
      <h2 class="font-display vx-reveal">Todo lo que lleva cada toma</h2>
      <p class="vx-ang__why vx-reveal" data-vx-delay="1">Cuatro complejos en una sola cucharada. Marcado, el que más tiene que ver con esta página; el resto va incluido.</p>
      <div class="vx-ang__table">
        <div class="vx-ang__cx{% if active == 'hydra' %} is-on{% endif %}"><h3>Hydra Performance Complex</h3><p>Sodio 600 mg · Potasio 300 mg · Magnesio bisglicinato 100 mg</p></div>
        <div class="vx-ang__cx{% if active == 'focus' %} is-on{% endif %}"><h3>Focus &amp; Energy Complex</h3><p>L-teanina 200 mg · Cafeína natural 100 mg</p></div>
        <div class="vx-ang__cx{% if active == 'perf' %} is-on{% endif %}"><h3>Performance Complex</h3><p>Creatina monohidrato 3.000 mg · Taurina 500 mg</p></div>
        <div class="vx-ang__cx{% if active == 'stress' %} is-on{% endif %}"><h3>Stress &amp; Recovery Complex</h3><p>KSM-66® Ashwagandha 300 mg</p></div>
      </div>
    </div>
  </div>

  <div class="vx-ang__block">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">Es para ti si…</p>
      <div class="vx-ang__fit">
        <div class="vx-ang__fit-col vx-reveal">
          <h3>Sí es para ti</h3>
          <ul>
            <li>Haces las cosas bien (comes, duermes, entrenas) y sientes que podrías rendir más.</li>
            <li>Lees etiquetas y prefieres dosis reales a eslóganes.</li>
            <li>Quieres una sola toma al día en vez de cuatro botes.</li>
          </ul>
        </div>
        <div class="vx-ang__fit-col vx-reveal" data-vx-delay="1">
          <h3>No es para ti</h3>
          <ul>
            <li>Si buscas resultados en 48 horas.</li>
            <li>Si no te vas a tomar una cucharada al día.</li>
            <li>Si eres menor de 18 años o competidor federado sujeto a control antidopaje.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="vx-ang__block vx-ang__block--alt">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">Lo que dicen quienes lo toman</p>
      <div class="vx-ang__quotes">
        {%- for block in section.blocks -%}
          <figure class="vx-ang__quote" {{ block.shopify_attributes }}>
            <blockquote>«{{ block.settings.quote }}»</blockquote>
            <figcaption><b>{{ block.settings.name }}</b>{% if block.settings.detail != blank %} · {{ block.settings.detail }}{% endif %}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  <div class="vx-ang__block">
    <div class="vx-ang__wrap">
      <p class="vx-eyebrow text-volt">Voltrix, en una sola toma</p>
      <p class="vx-ang__why vx-reveal">Hidratación, energía y foco, rendimiento y recuperación en un solo bote, por 1,67 € al día. Mira las otras formas de entrar en Voltrix:</p>
      <div class="vx-ang__chips">
        <a href="{{ routes.root_url }}pages/hidratacion" class="vx-ang__chip{% if a == 'hidratacion' %} is-on{% endif %}">Hidratación</a>
        <a href="{{ routes.root_url }}pages/energia-foco" class="vx-ang__chip{% if a == 'energia' %} is-on{% endif %}">Energía y foco</a>
        <a href="{{ routes.root_url }}pages/estres-recuperacion" class="vx-ang__chip{% if a == 'estres' %} is-on{% endif %}">Estrés y recuperación</a>
        <a href="{{ routes.root_url }}pages/rendimiento" class="vx-ang__chip{% if a == 'rendimiento' %} is-on{% endif %}">Rendimiento</a>
      </div>
    </div>
  </div>
</section>

<style>
  .vx-eyebrow { font-size: 10px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px; }
  .vx-ang { color: var(--color-white); }
  .vx-ang__wrap { max-width: 860px; margin: 0 auto; padding: 0 24px; }
  .vx-ang__hero { padding: 80px 0 64px; text-align: center; }
  .vx-ang__hero h1 { font-size: clamp(32px, 5.5vw, 54px); line-height: 1.15; color: var(--color-white); margin-bottom: 22px; }
  .vx-ang__hero h1 em { font-style: italic; color: var(--color-volt); }
  .vx-ang__sub { font-size: 17px; color: rgba(255,255,255,.75); line-height: 1.6; max-width: 600px; margin: 0 auto 28px; }
  .vx-ang__cta { display: inline-flex; align-items: center; justify-content: center; background: var(--color-volt); color: var(--color-ink); font-family: var(--font-body); font-size: 15px; font-weight: 800; padding: 16px 32px; border-radius: 12px; }
  .vx-ang__meta { font-size: 13px; color: rgba(255,255,255,.62); margin-top: 16px; }
  .vx-ang__block { padding: 72px 0; border-top: 1px solid #1E1E38; }
  .vx-ang__block--alt { background: rgba(255,255,255,.02); }
  .vx-ang__list { list-style: none; display: grid; gap: 12px; margin: 14px 0 24px; }
  .vx-ang__list li { padding: 18px 20px; background: rgba(255,255,255,.03); border: 1px solid #1E1E38; border-radius: 14px; font-size: 16px; line-height: 1.55; color: rgba(255,255,255,.85); }
  .vx-ang__mono { font-size: 15px; color: rgba(255,255,255,.65); }
  .vx-ang__mono em { color: var(--color-volt); font-style: italic; }
  .vx-ang h2 { font-size: clamp(26px, 3.6vw, 40px); line-height: 1.12; letter-spacing: -.3px; margin-bottom: 14px; }
  .vx-ang__why { font-size: 16px; color: rgba(255,255,255,.72); line-height: 1.72; max-width: 640px; margin-bottom: 32px; }
  .vx-ang__ings { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .vx-ang__ing { padding: 22px 20px; background: #10102A; border: 1px solid #1E1E38; border-radius: 16px; }
  .vx-ang__dose { font-family: var(--font-display); font-size: 34px; color: var(--color-volt); line-height: 1.1; margin-bottom: 6px; }
  .vx-ang__ing-name { font-size: 14px; font-weight: 800; color: var(--color-white); margin-bottom: 8px; }
  .vx-ang__ing-desc { font-size: 13px; color: rgba(255,255,255,.65); line-height: 1.6; }
  .vx-ang__foot { font-size: 11.5px; color: rgba(255,255,255,.5); line-height: 1.6; margin-top: 20px; max-width: 640px; }
  .vx-ang__chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .vx-ang__chip { padding: 11px 18px; border: 1px solid #2A2A4A; border-radius: 999px; font-size: 13.5px; font-weight: 700; color: rgba(255,255,255,.8); }
  .vx-ang__chip.is-on { background: rgba(200,241,53,.1); border-color: rgba(200,241,53,.45); color: var(--color-volt); }
  .vx-ang__steps { list-style: none; counter-reset: s; display: grid; gap: 12px; margin-top: 8px; }
  .vx-ang__steps li { counter-increment: s; position: relative; padding: 18px 20px 18px 62px; background: rgba(255,255,255,.03); border: 1px solid #1E1E38; border-radius: 14px; font-size: 15px; line-height: 1.6; color: rgba(255,255,255,.78); }
  .vx-ang__steps li::before { content: counter(s); position: absolute; left: 18px; top: 16px; width: 30px; height: 30px; border-radius: 50%; background: rgba(200,241,53,.1); border: 1px solid rgba(200,241,53,.4); color: var(--color-volt); font-weight: 800; display: flex; align-items: center; justify-content: center; font-size: 14px; }
  .vx-ang__steps b { color: var(--color-white); }
  .vx-ang__table { display: grid; gap: 12px; margin-top: 8px; }
  .vx-ang__cx { padding: 18px 20px; background: #10102A; border: 1px solid #1E1E38; border-radius: 14px; }
  .vx-ang__cx h3 { font-family: var(--font-body); font-size: 14px; font-weight: 800; color: var(--color-white); margin-bottom: 6px; }
  .vx-ang__cx p { font-size: 13.5px; color: rgba(255,255,255,.7); line-height: 1.55; }
  .vx-ang__cx.is-on { border-color: rgba(200,241,53,.55); background: rgba(200,241,53,.06); }
  .vx-ang__cx.is-on h3 { color: var(--color-volt); }
  .vx-ang__fit { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 8px; }
  .vx-ang__fit-col { padding: 22px 20px; background: rgba(255,255,255,.03); border: 1px solid #1E1E38; border-radius: 16px; }
  .vx-ang__fit-col h3 { font-family: var(--font-body); font-size: 14px; font-weight: 800; color: var(--color-volt); margin-bottom: 12px; }
  .vx-ang__fit-col ul { list-style: none; display: grid; gap: 10px; }
  .vx-ang__fit-col li { font-size: 14px; color: rgba(255,255,255,.75); line-height: 1.55; }
  .vx-ang__quotes { display: grid; gap: 14px; margin-top: 8px; }
  .vx-ang__quote { padding: 22px 20px; background: #10102A; border: 1px solid #1E1E38; border-radius: 16px; }
  .vx-ang__quote blockquote { font-size: 16px; line-height: 1.65; color: rgba(255,255,255,.88); margin-bottom: 12px; }
  .vx-ang__quote figcaption { font-size: 13px; color: rgba(255,255,255,.6); }
  .vx-ang__quote b { color: var(--color-white); }
  .vx-ang__why + .vx-ang__why { margin-top: -12px; }
  @media (max-width: 700px) { .vx-ang__fit { grid-template-columns: 1fr; } }
  @media (max-width: 700px) {
    .vx-ang__hero { padding: 56px 0 48px; }
    .vx-ang__block { padding: 52px 0; }
    .vx-ang__wrap { padding: 0 20px; }
  }
</style>

{% schema %}
{
  "name": "Landing de ángulo",
  "settings": [
    {
      "type": "select",
      "id": "angle",
      "label": "Ángulo",
      "default": "hidratacion",
      "options": [
        { "value": "hidratacion", "label": "Hidratación" },
        { "value": "energia", "label": "Energía y foco" },
        { "value": "estres", "label": "Estrés y recuperación" },
        { "value": "rendimiento", "label": "Rendimiento" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "testimonio",
      "name": "Testimonio real",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Opinión (solo de clientes reales, con su permiso)" },
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "text", "id": "detail", "label": "Detalle (ciudad, edad, deporte…)" }
      ]
    }
  ],
  "presets": [{ "name": "Landing de ángulo" }]
}
{% endschema %}
