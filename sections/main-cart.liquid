<section class="vx-cart section--dark page-width">
  <h1 class="font-display">Tu carrito</h1>

  <div data-vx-cart-empty style="{% if cart.item_count > 0 %}display:none;{% endif %}">
    <p class="vx-cart__empty">Tu carrito está vacío.</p>
    <a href="{{ routes.root_url }}#producto" class="vx-btn-add">Ver el producto →</a>
  </div>

  <div data-vx-cart-full style="{% if cart.item_count == 0 %}display:none;{% endif %}">
    <div class="vx-cart__items" data-vx-cart-items>
      {% for item in cart.items %}
        <div class="vx-cart__item" data-vx-line-key="{{ item.key }}">
          <div class="vx-cart__item-info">
            <div class="vx-cart__item-title">
              {{ item.product.title }}
              {% if item.selling_plan_allocation %}
                {% assign vx_plan_opt = item.selling_plan_allocation.selling_plan.options.first.value %}
                {% assign vx_plan_n = vx_plan_opt | slice: 0, 1 | plus: 0 %}
                {% if vx_plan_n < 1 or vx_plan_n > 3 %}{% assign vx_plan_n = 1 %}{% endif %}
                <span class="vx-cart__sub-badge">{% if vx_plan_n == 1 %}Suscripción mensual{% else %}Suscripción cada {{ vx_plan_n }} meses{% endif %}</span>
              {% endif %}
            </div>
            <div class="vx-cart__item-price-unit"><span data-vx-unit-price>{{ item.final_price | money }}</span> / unidad</div>
            {% if item.selling_plan_allocation %}
              <div class="vx-cart__sub-desc">Se renueva {% if vx_plan_n == 1 %}cada mes{% else %}cada {{ vx_plan_n }} meses{% endif %} · Cancela cuando quieras</div>
            {% endif %}
          </div>
          <div class="vx-cart__item-qty">
            <label class="vx-cart__qty-label">Cantidad</label>
            <div class="vx-cart__qty-stepper">
              <button type="button" class="vx-cart__qty-btn" data-vx-qty-minus data-line-key="{{ item.key }}" aria-label="Reducir cantidad">−</button>
              <span class="vx-cart__qty-value" data-vx-qty-value data-line-key="{{ item.key }}">{{ item.quantity }}</span>
              <button type="button" class="vx-cart__qty-btn" data-vx-qty-plus data-line-key="{{ item.key }}" aria-label="Aumentar cantidad">+</button>
            </div>
          </div>
          <div class="vx-cart__item-line-price" data-vx-line-price>{{ item.final_line_price | money }}</div>
          <button type="button" class="vx-cart__remove" data-vx-remove data-line-key="{{ item.key }}" aria-label="Eliminar {{ item.title | escape }} del carrito" title="Eliminar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
          </button>
        </div>
      {% endfor %}
    </div>

    <p class="vx-cart__hint">Cambia la cantidad con + / − o quita un producto con la papelera.</p>
    <p class="vx-cart__status" data-vx-cart-status></p>

    <div class="vx-cart__total">
      <span>Total</span>
      <span data-vx-cart-total>{{ cart.total_price | money }}</span>
    </div>

    <a href="{{ routes.cart_url }}checkout" class="vx-btn-add">Ir a pagar →</a>
  </div>

  <div class="vx-guarantees">
    <div class="vx-guarantee">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      <div>
        <div class="vx-guarantee__titulo">Entrega en 2–4 días</div>
        <div class="vx-guarantee__desc">Pedidos procesados el mismo día laborable (antes de las 14:00)</div>
      </div>
    </div>
    <div class="vx-guarantee">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
      <div>
        <div class="vx-guarantee__titulo">Garantía de 30 días</div>
        <div class="vx-guarantee__desc">Si no lo notas, te devolvemos el dinero</div>
      </div>
    </div>
    <div class="vx-guarantee">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      <div>
        <div class="vx-guarantee__titulo">Pago 100% seguro</div>
        <div class="vx-guarantee__desc">Tarjeta, Apple Pay, Google Pay y más</div>
      </div>
    </div>
    <div class="vx-guarantee">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <div>
        <div class="vx-guarantee__titulo">Cancela cuando quieras</div>
        <div class="vx-guarantee__desc">Sin permanencia en la suscripción</div>
      </div>
    </div>
  </div>
</section>

<style>
  .vx-cart { padding: 60px 24px 88px; }
  .vx-cart h1 { font-size: clamp(26px, 4vw, 36px); margin-bottom: 28px; }

  .vx-cart__items { display: flex; flex-direction: column; gap: 12px; margin-bottom: 8px; }
  .vx-cart__item {
    display: grid; grid-template-columns: 1fr auto auto auto; gap: 20px; align-items: center;
    background: rgba(255,255,255,.03); border: 1px solid #1E1E38; border-radius: 12px; padding: 16px 20px;
    transition: opacity .2s ease;
  }
  .vx-cart__item.is-updating { opacity: .4; pointer-events: none; }
  .vx-cart__item-title { font-size: 14px; font-weight: 700; color: var(--color-white); margin-bottom: 3px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .vx-cart__sub-badge {
    display: inline-flex; align-items: center; font-size: 10px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase;
    background: rgba(200,241,53,.12); color: var(--color-volt); border: 1px solid rgba(200,241,53,.3);
    border-radius: 999px; padding: 3px 9px;
  }
  .vx-cart__item-price-unit { font-size: 12px; color: rgba(255,255,255,.4); }
  .vx-cart__sub-desc { font-size: 11px; color: rgba(255,255,255,.3); margin-top: 3px; }

  .vx-cart__item-qty { display: flex; flex-direction: column; gap: 6px; align-items: center; }
  .vx-cart__qty-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,.3); }
  .vx-cart__qty-stepper {
    display: flex; align-items: center; gap: 0; border: 1px solid #28284A; border-radius: 8px; overflow: hidden;
  }
  .vx-cart__qty-btn {
    width: 36px; height: 36px; background: rgba(255,255,255,.05); border: none; color: var(--color-white);
    font-size: 18px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center;
    touch-action: manipulation;
  }
  .vx-cart__qty-btn:hover { background: rgba(200,241,53,.12); color: var(--color-volt); }
  .vx-cart__qty-btn:active { background: rgba(200,241,53,.25); }
  .vx-cart__qty-value { min-width: 32px; text-align: center; font-size: 14px; font-weight: 800; color: var(--color-white); }

  .vx-cart__item-line-price { font-size: 15px; font-weight: 800; color: var(--color-volt); white-space: nowrap; }

  .vx-cart__remove {
    width: 38px; height: 38px; border-radius: 10px; border: 1px solid #28284A; background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.5); display: flex; align-items: center; justify-content: center; cursor: pointer;
    transition: color .15s ease, border-color .15s ease, background .15s ease; touch-action: manipulation;
  }
  .vx-cart__remove:hover, .vx-cart__remove:focus-visible { color: #F87171; border-color: rgba(248,113,113,.5); background: rgba(248,113,113,.08); outline: none; }
  .vx-cart__item { position: relative; }
  .vx-cart__hint { font-size: 12px; color: rgba(255,255,255,.35); margin-bottom: 6px; }
  .vx-cart__status { font-size: 12px; color: var(--color-volt); min-height: 16px; margin-bottom: 14px; }

  .vx-cart__total { display: flex; justify-content: space-between; font-size: 17px; font-weight: 800; color: var(--color-white); padding: 16px 4px; border-top: 1px solid #1E1E38; margin-bottom: 24px; }
  .vx-cart__empty { font-size: 14px; color: rgba(255,255,255,.5); margin-bottom: 24px; }

  .vx-btn-add {
    display: inline-block; text-align: center; padding: 15px 28px;
    background: var(--color-volt); color: var(--color-ink); font-weight: 900; font-size: 14px;
    border-radius: 12px; border: none; cursor: pointer;
  }

  .vx-guarantees { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; border-top: 1px solid #1E1E38; padding-top: 36px; margin-top: 16px; }
  .vx-guarantee { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; background: rgba(255,255,255,.02); border: 1px solid #1E1E38; border-radius: 12px; padding: 18px 16px; }
  .vx-guarantee svg { color: var(--color-volt); flex-shrink: 0; }
  .vx-guarantee__titulo { font-size: 13px; font-weight: 800; color: var(--color-white); margin-bottom: 3px; }
  .vx-guarantee__desc { font-size: 11px; color: rgba(255,255,255,.4); line-height: 1.5; }

  @media (max-width: 700px) {
    .vx-cart__item { grid-template-columns: 1fr; gap: 12px; justify-items: start; padding-right: 64px; }
    .vx-cart__remove { position: absolute; top: 14px; right: 14px; }
    .vx-cart__item-line-price { justify-self: flex-start; }
    .vx-guarantees { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  (function () {
    var container = document.querySelector('[data-vx-cart-items]');
    if (!container) return;

    var statusEl = document.querySelector('[data-vx-cart-status]');
    var totalEl = document.querySelector('[data-vx-cart-total]');
    var emptyBox = document.querySelector('[data-vx-cart-empty]');
    var fullBox = document.querySelector('[data-vx-cart-full]');
    var busy = {};

    function formatMoney(cents) {
      return (cents / 100).toLocaleString('es-ES', { style: 'currency', currency: '{{ cart.currency.iso_code }}' });
    }

    function updateLine(key, quantity) {
      if (busy[key]) return;
      busy[key] = true;

      var itemEl = container.querySelector('[data-vx-line-key="' + key + '"]');
      if (itemEl) itemEl.classList.add('is-updating');
      if (statusEl) statusEl.textContent = 'Actualizando...';

      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: quantity })
      })
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          busy[key] = false;

          if (quantity === 0 && itemEl) itemEl.remove();
          if (itemEl) itemEl.classList.remove('is-updating');

          // Refrescar todas las líneas (los descuentos por pack pueden cambiar otras filas)
          cart.items.forEach(function (it) {
            var row = container.querySelector('[data-vx-line-key="' + it.key + '"]');
            if (!row) return;
            var lp = row.querySelector('[data-vx-line-price]');
            var up = row.querySelector('[data-vx-unit-price]');
            var qv = row.querySelector('[data-vx-qty-value]');
            if (lp) lp.textContent = formatMoney(it.final_line_price);
            if (up) up.textContent = formatMoney(it.final_price);
            if (qv) qv.textContent = it.quantity;
          });

          if (totalEl) totalEl.textContent = formatMoney(cart.total_price);
          if (statusEl) {
            statusEl.textContent = 'Carrito actualizado ✓';
            setTimeout(function () { statusEl.textContent = ''; }, 1500);
          }

          document.dispatchEvent(new CustomEvent('vx:cart:updated', { detail: cart }));

          if (cart.item_count === 0) {
            if (fullBox) fullBox.style.display = 'none';
            if (emptyBox) emptyBox.style.display = 'block';
          }
        })
        .catch(function () {
          busy[key] = false;
          if (itemEl) itemEl.classList.remove('is-updating');
          if (statusEl) statusEl.textContent = 'No se pudo actualizar, inténtalo de nuevo.';
        });
    }

    container.addEventListener('click', function (e) {
      var removeBtn = e.target.closest('[data-vx-remove]');
      if (removeBtn) { updateLine(removeBtn.getAttribute('data-line-key'), 0); return; }
      var minusBtn = e.target.closest('[data-vx-qty-minus]');
      var plusBtn = e.target.closest('[data-vx-qty-plus]');
      if (!minusBtn && !plusBtn) return;

      var key = (minusBtn || plusBtn).getAttribute('data-line-key');
      var valueEl = container.querySelector('[data-vx-qty-value][data-line-key="' + key + '"]');
      if (!valueEl) return;

      var current = parseInt(valueEl.textContent, 10) || 0;
      var next = minusBtn ? Math.max(0, current - 1) : current + 1;

      updateLine(key, next);
    });
  })();
</script>

{% schema %}
{ "name": "Carrito principal", "settings": [] }
{% endschema %}
