<style>
  .vx-aut { padding: 88px 24px; }
  .vx-aut h2 { font-size: clamp(28px, 3.8vw, 48px); line-height: 1.1; letter-spacing: -.4px; margin-bottom: 12px; }
  .vx-aut h2 em { font-style: italic; color: var(--color-volt); }
  .vx-aut__sub { font-size: 16px; color: rgba(255,255,255,.5); max-width: 560px; line-height: 1.72; margin-bottom: 56px; }

  /* --- El criterio (4 complejos) --- */
  .vx-metodo { margin-bottom: 88px; }
  .vx-metodo h2 { font-size: clamp(28px, 3.8vw, 48px); line-height: 1.1; letter-spacing: -.4px; margin-bottom: 12px; }
  .vx-metodo h2 em { font-style: italic; color: var(--color-volt); }
  .vx-metodo__sub { font-size: 16px; color: rgba(255,255,255,.5); max-width: 620px; line-height: 1.72; margin-bottom: 56px; }

  .vx-metodo-list { max-width: 720px; }
  .vx-metodo-item { display: grid; grid-template-columns: 64px 1fr; gap: 26px; position: relative; margin-bottom: 64px; }
  .vx-metodo-item:last-child { margin-bottom: 0; }
  .vx-metodo-item__marker {
    width: 64px; height: 64px; border-radius: 50%; border: 1.5px solid rgba(200,241,53,.4);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    background: var(--color-ink); box-shadow: 0 0 20px rgba(200,241,53,.15); z-index: 2; color: var(--color-volt);
  }
  .vx-metodo-item__marker svg { width: 26px; height: 26px; }
  .vx-metodo-item__connector { position: absolute; left: 31px; top: 64px; width: 1px; height: calc(100% + 8px); background: rgba(255,255,255,.1); }
  .vx-metodo-item__title { font-family: var(--font-display); font-size: 24px; color: var(--color-white); margin-bottom: 12px; }
  .vx-metodo-item__body p { font-size: 15px; color: rgba(255,255,255,.55); line-height: 1.7; max-width: 560px; margin-bottom: 20px; }
  .vx-metodo-item__tags { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
  .vx-tag { display: inline-block; padding: 7px 16px; border: 1px solid rgba(200,241,53,.35); border-radius: 999px; font-size: 12.5px; font-weight: 700; color: var(--color-volt); }
  .vx-metodo-item__stat { font-size: 14px; color: rgba(255,255,255,.5); padding-top: 16px; border-top: 1px solid rgba(255,255,255,.08); }
  .vx-metodo-item__stat strong { font-family: var(--font-display); font-size: 26px; color: var(--color-volt); margin-right: 8px; }

  /* --- Los ingredientes (tarjetas cortas) --- */
  .vx-ing-section h2 { margin-bottom: 32px; }
  .vx-aut__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px; }
  .vx-aut__item {
    background: rgba(255,255,255,.03); border: 1px solid #1E1E38; border-radius: 16px; padding: 26px 24px;
    position: relative; overflow: hidden;
  }
  .vx-aut__item::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-volt), transparent);
  }
  .vx-aut__label { font-size: 10px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,.35); margin-bottom: 8px; }
  .vx-aut__brand { font-family: var(--font-display); font-size: 28px; color: var(--color-volt); line-height: 1; margin-bottom: 14px; }
  .vx-aut__brand sup { font-size: 14px; }
  .vx-aut__stat { font-size: 13px; font-weight: 800; color: var(--color-white); margin-bottom: 12px; line-height: 1.35; }
  .vx-aut__desc { font-size: 13px; color: rgba(255,255,255,.4); line-height: 1.65; }

  .vx-aut__closing {
    display: flex; align-items: flex-start; gap: 22px;
    background: rgba(200,241,53,.05); border: 1px solid rgba(200,241,53,.2); border-radius: 16px;
    padding: 28px 26px; margin-top: 12px;
  }
  .vx-aut__closing-num { font-family: var(--font-display); font-size: 46px; color: var(--color-volt); line-height: 1; flex-shrink: 0; }
  .vx-aut__closing-titulo { font-size: 16px; font-weight: 800; color: var(--color-white); margin-bottom: 8px; }
  .vx-aut__closing-desc { font-size: 13.5px; color: rgba(255,255,255,.5); line-height: 1.65; }


  .vx-car-dots { display: none; justify-content: center; gap: 8px; margin-top: 16px; }
  .vx-car-dots button { width: 7px; height: 7px; border-radius: 99px; border: 0; padding: 0; background: rgba(255,255,255,.2); cursor: pointer; transition: width .3s ease, background .3s ease; }
  .vx-car-dots button.on { width: 22px; background: var(--color-volt); }

  .vx-metodo-item__marker { animation: vxPulse 3.2s ease-in-out infinite; }
  @keyframes vxPulse { 0%,100% { box-shadow: 0 0 14px rgba(200,241,53,.12); } 50% { box-shadow: 0 0 28px rgba(200,241,53,.34); } }
  .vx-aut__item::before { transform: scaleX(0); transition: transform 1s ease .3s; }
  .vx-aut__item.vx-reveal--in::before { transform: scaleX(1); }
  @media (hover: hover) { .vx-aut__item { transition: opacity .7s ease, transform .35s ease, border-color .3s ease; } .vx-aut__item:hover { transform: translateY(-4px); border-color: rgba(200,241,53,.35); } }
  @media (prefers-reduced-motion: reduce) { .vx-metodo-item__marker { animation: none; } }
  @media (max-width: 900px) {
    .vx-aut__grid {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin: 0 -24px 0; padding: 0 24px; scroll-padding-left: 24px; overscroll-behavior-x: contain;
    }
    .vx-aut__grid::-webkit-scrollbar { display: none; }
    .vx-aut__item { flex: 0 0 80%; scroll-snap-align: start; }
    .vx-ing-section .vx-car-dots { display: flex; margin-bottom: 8px; }
  }
  @media (max-width: 600px) {
    .vx-metodo-list { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 -24px; padding: 0 24px; scroll-padding-left: 24px; overscroll-behavior-x: contain; }
    .vx-metodo-list::-webkit-scrollbar { display: none; }
    .vx-metodo-item { display: block; flex: 0 0 86%; scroll-snap-align: start; margin: 0; padding: 22px 20px; background: rgba(255,255,255,.03); border: 1px solid #1E1E38; border-radius: 18px; }
    .vx-metodo-item__connector { display: none; }
    .vx-metodo-item__marker { width: 44px; height: 44px; margin-bottom: 14px; }
    .vx-metodo-item__title { font-size: 21px; }
    .vx-metodo .vx-car-dots { display: flex; }
    .vx-metodo { margin-bottom: 64px; }
    .vx-metodo-item { grid-template-columns: 48px 1fr; gap: 16px; }
    .vx-metodo-item__marker { width: 48px; height: 48px; }
    .vx-metodo-item__marker svg { width: 20px; height: 20px; }
    .vx-metodo-item__connector { left: 23px; }
    .vx-aut__closing { flex-direction: column; gap: 10px; }
  }
</style>
<script>
(function () {
  function carousel(trackSel, dotsClass) {
    var track = document.querySelector(trackSel);
    if (!track || track.getAttribute('data-vx-car')) return;
    track.setAttribute('data-vx-car', '1');
    var slides = Array.prototype.slice.call(track.children);
    var dots = document.createElement('div');
    dots.className = 'vx-car-dots ' + dotsClass;
    slides.forEach(function (s, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.setAttribute('aria-label', 'Ir a ' + (i + 1));
      b.addEventListener('click', function () { track.scrollTo({ left: s.offsetLeft - track.offsetLeft - 0, behavior: 'smooth' }); });
      dots.appendChild(b);
    });
    track.parentNode.insertBefore(dots, track.nextSibling);
    function upd() {
      var w = slides[0].offsetWidth + 12;
      var i = Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / w)));
      Array.prototype.forEach.call(dots.children, function (d, k) { d.classList.toggle('on', k === i); });
    }
    track.addEventListener('scroll', upd, { passive: true });
    upd();
  }
  window.vxCarousel = window.vxCarousel || carousel;
})();

document.addEventListener('DOMContentLoaded', function () {
  window.vxCarousel('.vx-metodo-list', 'vx-car-dots--metodo');
  window.vxCarousel('.vx-aut__grid', 'vx-car-dots--ing');
  var els = document.querySelectorAll('[data-vx-count]');
  if (!els.length || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      var el = e.target, end = parseFloat(el.getAttribute('data-vx-count')), dec = parseInt(el.getAttribute('data-dec') || '0', 10), t0 = null;
      function step(t) {
        if (!t0) t0 = t;
        var k = Math.min((t - t0) / 1200, 1), v = end * (1 - Math.pow(1 - k, 3));
        el.textContent = v.toFixed(dec).replace('.', ',');
        if (k < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  }, { threshold: 0.6 });
  els.forEach(function (el) { io.observe(el); });
});
</script>
