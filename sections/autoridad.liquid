<script>
(function () {
  /* Volteo: las tarjetas se dan la vuelta como cartas al deslizar (infinito). Solo móvil. */
  function vxFlip(sel, dotsClass, maxW) {
    var grid = document.querySelector(sel);
    if (!grid || grid.getAttribute('data-vx-flip')) return;
    grid.setAttribute('data-vx-flip', '1');
    var items = Array.prototype.slice.call(grid.children), n = items.length;
    var mq = window.matchMedia('(max-width: ' + maxW + 'px)');
    var pos = 0, W = 0, raf = 0, on = false, drag = false, locked = false, sx = 0, sy = 0, spos = 0, lastX = 0, lastT = 0, vel = 0;
    var dots = document.createElement('div');
    dots.className = 'vx-car-dots ' + dotsClass;
    items.forEach(function (it, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.setAttribute('aria-label', 'Ir a ' + (i + 1));
      b.addEventListener('click', function () { var d = i - pos; d = ((d + n / 2) % n + n) % n - n / 2; animTo(pos + d); });
      dots.appendChild(b);
    });
    grid.parentNode.insertBefore(dots, grid.nextSibling);

    function wrap(d) { return ((d + n / 2) % n + n) % n - n / 2; }
    function render() {
      items.forEach(function (it, i) {
        var d = wrap(i - pos), a = d * 180;
        it.style.transform = 'rotateY(' + a.toFixed(1) + 'deg)';
        var front = Math.abs(d) < 0.5;
        it.style.zIndex = front ? 2 : 1;
        it.style.pointerEvents = front ? '' : 'none';
        it.style.boxShadow = '0 ' + (14 * Math.cos(d * Math.PI)).toFixed(0) + 'px 40px rgba(0,0,0,' + (0.35 * Math.max(0, Math.cos(d * Math.PI))).toFixed(2) + ')';
      });
      var idx = ((Math.round(pos) % n) + n) % n;
      Array.prototype.forEach.call(dots.children, function (b, k) { b.classList.toggle('on', k === idx); });
    }
    function measure() {
      var h = 0;
      items.forEach(function (it) { it.style.height = 'auto'; });
      items.forEach(function (it) { h = Math.max(h, it.offsetHeight); });
      items.forEach(function (it) { it.style.height = h + 'px'; });
      grid.style.height = (h + 8) + 'px';
      W = grid.clientWidth; render();
    }
    function animTo(target) {
      cancelAnimationFrame(raf);
      var from = pos, t0 = null, dur = 520;
      function step(t) {
        if (!t0) t0 = t;
        var k = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - k, 3);
        pos = from + (target - from) * e; render();
        if (k < 1) raf = requestAnimationFrame(step); else { pos = ((target % n) + n) % n; render(); }
      }
      raf = requestAnimationFrame(step);
    }
    function down(e) { if (!on) return; cancelAnimationFrame(raf); drag = true; locked = false; sx = lastX = e.clientX; sy = e.clientY; spos = pos; lastT = performance.now(); vel = 0; }
    function move(e) {
      if (!drag) return;
      var mx = e.clientX - sx, my = e.clientY - sy;
      if (!locked) { if (Math.abs(mx) > 8 && Math.abs(mx) > Math.abs(my)) { locked = true; try { grid.setPointerCapture(e.pointerId); } catch (_) {} } else return; }
      var now = performance.now(); vel = (lastX - e.clientX) / (W * 0.9) / Math.max(1, now - lastT) * 1000; lastX = e.clientX; lastT = now;
      pos = spos - mx / (W * 0.9); render();
    }
    function up() {
      if (!drag) return; drag = false;
      if (!locked) return;
      animTo(Math.round(pos + Math.max(-0.9, Math.min(0.9, vel * 0.2))));
    }
    grid.addEventListener('pointerdown', down);
    grid.addEventListener('pointermove', move);
    grid.addEventListener('pointerup', up);
    grid.addEventListener('pointercancel', up);
    function enable() {
      if (mq.matches === on) { if (on) measure(); return; }
      on = mq.matches;
      grid.classList.toggle('is-flip', on);
      dots.style.display = on ? '' : 'none';
      if (on) measure();
      else { items.forEach(function (it) { it.style.cssText = ''; }); grid.style.height = ''; }
    }
    window.addEventListener('resize', enable);
    window.addEventListener('load', function () { if (on) measure(); });
    enable();
  }
  window.vxFlip = vxFlip;
})();
</script>
<script>
(function () {
  function carousel(trackSel, dotsClass) {
    var track = document.querySelector(trackSel);
    if (!track || track.getAttribute('data-vx-car')) return;
    track.setAttribute('data-vx-car', '1');
    var slides = Array.prototype.slice.call(track.children);
    var dots = document.createElement('div');
    dots.className = 'vx-car-dots ' + dotsClass;
    slides.forEach(function (s, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.setAttribute('aria-label', 'Ir a ' + (i + 1));
      b.addEventListener('click', function () { track.scrollTo({ left: s.offsetLeft - track.offsetLeft - 0, behavior: 'smooth' }); });
      dots.appendChild(b);
    });
    track.parentNode.insertBefore(dots, track.nextSibling);
    function upd() {
      var w = slides[0].offsetWidth + 12;
      var i = Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / w)));
      Array.prototype.forEach.call(dots.children, function (d, k) { d.classList.toggle('on', k === i); });
    }
    track.addEventListener('scroll', upd, { passive: true });
    upd();
  }
  window.vxCarousel = window.vxCarousel || carousel;
})();

document.addEventListener('DOMContentLoaded', function () {
  window.vxFlip('.vx-metodo-list', 'vx-car-dots--metodo', 600);
  window.vxCarousel('.vx-aut__grid', 'vx-car-dots--ing');
  var els = document.querySelectorAll('[data-vx-count]');
  if (!els.length || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      var el = e.target, end = parseFloat(el.getAttribute('data-vx-count')), dec = parseInt(el.getAttribute('data-dec') || '0', 10), t0 = null;
      function step(t) {
        if (!t0) t0 = t;
        var k = Math.min((t - t0) / 1200, 1), v = end * (1 - Math.pow(1 - k, 3));
        el.textContent = v.toFixed(dec).replace('.', ',');
        if (k < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    });
  }, { threshold: 0.6 });
  els.forEach(function (el) { io.observe(el); });
});
</script>
