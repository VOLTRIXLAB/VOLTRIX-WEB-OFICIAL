<div class="pol">
<style>
.pol { font-family: 'Inter', sans-serif; background: #0A0A1A; color: #fff; line-height: 1.7; -webkit-font-smoothing: antialiased; padding: 64px 24px 96px; }
.pol *, .pol *::before, .pol *::after { box-sizing: border-box; }
.pol { --pv: #C8F135; --pb: #2563EB; --pw70: rgba(255,255,255,.7); --pw50: rgba(255,255,255,.5); --pw35: rgba(255,255,255,.35); --pw25: rgba(255,255,255,.25); --pborder: #1E1E38; --ppanel: rgba(255,255,255,.03); }

.pol .pol-wrap { max-width: 860px; margin: 0 auto; }

.pol .pol-header { border-bottom: 1px solid var(--pborder); padding-bottom: 32px; margin-bottom: 40px; }
.pol .pol-logo-link { display: inline-block; margin-bottom: 40px; }
.pol .pol-logo-img { height: 24px; width: auto; }
.pol .pol-eyebrow-top { font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: var(--pv); margin-bottom: 10px; }
.pol .pol-header h1 { font-family: 'DM Serif Display', serif; font-size: clamp(28px, 4.5vw, 40px); font-weight: 400; color: #fff; margin-bottom: 8px; }
.pol .pol-header-sub { font-size: 13px; color: var(--pw35); }

.pol .pol-indice { background: var(--ppanel); border: 1px solid var(--pborder); border-radius: 14px; padding: 24px 28px; margin-bottom: 48px; }
.pol .pol-indice-titulo { font-size: 11px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: var(--pv); margin-bottom: 14px; }
.pol .pol-indice-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.pol .pol-indice-list a { font-size: 14px; color: var(--pw70); text-decoration: none; font-weight: 500; }
.pol .pol-indice-list a:hover { color: var(--pv); }

.pol .politica { margin-bottom: 56px; padding-bottom: 56px; border-bottom: 1px solid var(--pborder); }
.pol .politica:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.pol .pol-eyebrow { font-size: 10px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: var(--pv); margin-bottom: 8px; }
.pol .pol-titulo { font-family: 'DM Serif Display', serif; font-size: clamp(22px, 3.5vw, 32px); font-weight: 400; color: #fff; margin-bottom: 18px; line-height: 1.25; }
.pol .pol-actualizado { font-size: 12px; color: var(--pw25); margin-bottom: 24px; }

.pol .pol-content h3 { font-size: 15px; font-weight: 800; color: #fff; margin: 24px 0 10px; }
.pol .pol-content h3:first-child { margin-top: 0; }
.pol .pol-content p { font-size: 14px; color: var(--pw70); margin-bottom: 14px; }
.pol .pol-content ul { margin: 0 0 14px 20px; display: flex; flex-direction: column; gap: 6px; }
.pol .pol-content ul li { font-size: 14px; color: var(--pw70); line-height: 1.65; }
.pol .pol-content strong { color: #fff; font-weight: 700; }
.pol .pol-content a { color: var(--pv); }

.pol .highlight { background: rgba(200,241,53,.08); border: 1px solid rgba(200,241,53,.22); border-radius: 10px; padding: 16px 18px; margin: 16px 0; }
.pol .highlight p { margin: 0; color: var(--pv); font-weight: 600; }

.pol .pol-footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--pborder); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; }
.pol .pol-footer-brand { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--pw50); }
.pol .pol-footer-logo-img { height: 16px; width: auto; }
.pol .pol-footer-note { font-size: 11px; color: var(--pw25); text-align: right; }

@media (max-width: 600px) {
  .pol { padding: 48px 16px 72px; }
  .pol-footer { flex-direction: column; align-items: flex-start; }
  .pol-footer-note { text-align: left; }
}
</style>

