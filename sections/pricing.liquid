  html body .appstle_circle {
    border-color: rgba(255,255,255,.3) !important;
  }
  html body .appstle-active-option .appstle_circle,
  html body .appstle_selected_background .appstle_circle {
    border-color: var(--color-volt) !important;
  }
  html body .appstle_dot {
    background: var(--color-volt) !important;
  }
  .appstle_subscription_radio_wrapper input[type="radio"] {
    accent-color: var(--color-volt) !important;
  }
  @media (max-width: 700px) {
    .vx-prod__layout { grid-template-columns: 1fr; }
    .vx-price-card { padding: 26px 22px; }
  }
</style>
<script>
(function () {
  var galleries = document.querySelectorAll('[data-vx-gallery]');
  galleries.forEach(function (gallery) {
    var slides = gallery.querySelectorAll('[data-vx-slide]');
    var thumbs = gallery.querySelectorAll('[data-vx-thumb]');
    var prevBtn = gallery.querySelector('[data-vx-prev]');
    var nextBtn = gallery.querySelector('[data-vx-next]');
    var total = slides.length;
    var current = 0;

    function goTo(index) {
      current = (index + total) % total;
      slides.forEach(function (s) { s.classList.remove('is-active'); });
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      slides[current].classList.add('is-active');
      if (thumbs[current]) thumbs[current].classList.add('is-active');
    }

    thumbs.forEach(function (thumb, i) {
      thumb.addEventListener('click', function () { goTo(i); });
    });
    if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); });
  });
})();
</script>
{% if vx_product %}
{% assign vx_v = vx_product.variants.first %}
{% for v in vx_product.variants %}{% if v.option1 == 'Suscripción' %}{% assign vx_v = v %}{% endif %}{% endfor %}
<script>
(function () {
  var form = document.getElementById('vx-buy-form');
  if (!form) return;
  var BASE = {{ vx_v.price }};
  var ONCE_DISCOUNT = { 1: 0, 2: 0.10, 3: 0.15 }; // Debe coincidir con las promos automáticas de Shopify
  var ALLOC = [
    {% for a in vx_v.selling_plan_allocations %}{ id: {{ a.selling_plan.id }}, price: {{ a.price }}, key: {{ a.selling_plan.options.first.value | json }}, name: {{ a.selling_plan.name | json }} }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  var plans = {};
  ALLOC.forEach(function (a) {
    var m = /^(\d+)MONTH/.exec(a.key || '') || /(\d+)\s*mes/i.exec(a.name || '');
    var n = m ? parseInt(m[1], 10) : (/mensual/i.test(a.name || '') ? 1 : 0);
    if (n >= 1 && n <= 3 && !plans[n]) plans[n] = a;
  });

  var idEl = form.querySelector('[data-vx-id]');
  var qtyEl = form.querySelector('[data-vx-qty]');
  var planEl = form.querySelector('[data-vx-plan]');
  var btn = form.querySelector('[data-vx-buy-btn]');
  var labelEl = form.querySelector('[data-vx-btn-label]');
  var priceEl = form.querySelector('[data-vx-btn-price]');
  var compareEl = form.querySelector('[data-vx-btn-compare]');
  var state = { n: 2, mode: 'sub' };

  function fmt(c) { return (c / 100).toLocaleString('es-ES', { style: 'currency', currency: '{{ cart.currency.iso_code }}' }); }
  function onceTotal(n) { return Math.round(BASE * n * (1 - ONCE_DISCOUNT[n])); }
  function subTotal(n) { return plans[n] ? plans[n].price * n : null; }
  function q(sel) { return form.querySelector(sel); }
  function bump(el) { if (!el) return; el.classList.remove('vx-bump'); void el.offsetWidth; el.classList.add('vx-bump'); }

  function render(animate) {
    var n = state.n;
    if (!plans[n] && state.mode === 'sub') state.mode = 'once';

    // Tarjetas de pack
    [1, 2, 3].forEach(function (k) {
      var total = state.mode === 'sub' && plans[k] ? subTotal(k) : onceTotal(k);
      var full = BASE * k;
      q('[data-vx-unit="' + k + '"]').textContent = fmt(total / k) + '/bote';
      var pct = Math.round((1 - total / full) * 100);
      q('[data-vx-save="' + k + '"]').textContent = pct > 0 ? 'Ahorras ' + pct + '%' : '';
      var opt = q('[data-vx-pack-opt="' + k + '"]');
      opt.classList.toggle('is-on', k === n);
      opt.querySelector('input').checked = (k === n);
    });

    // Modo suscripción
    var sT = subTotal(n), oT = onceTotal(n), full = BASE * n;
    var subOpt = q('[data-vx-mode-opt="sub"]');
    subOpt.classList.toggle('is-off', !plans[n]);
    subOpt.querySelector('input').disabled = !plans[n];
    if (plans[n]) {
      q('[data-vx-sub-price]').textContent = fmt(sT);
      q('[data-vx-sub-compare]').textContent = fmt(full);
      q('[data-vx-freq]').textContent = n === 1 ? 'cada mes' : 'cada ' + n + ' meses';
    } else {
      q('[data-vx-sub-price]').textContent = 'No disponible';
      q('[data-vx-sub-compare]').textContent = '';
    }
    var extraEl = q('[data-vx-extra]');
    if (plans[n]) {
      var subPct = Math.round((1 - sT / full) * 100);
      extraEl.textContent = subPct + '% de descuento';
      extraEl.hidden = subPct <= 0;
    } else { extraEl.hidden = true; }
    q('[data-vx-once-price]').textContent = fmt(oT);
    var onceTag = q('[data-vx-once-tag]');
    var oncePct = Math.round((1 - oT / full) * 100);
    onceTag.textContent = oncePct + '% de descuento';
    onceTag.hidden = oncePct <= 0;
    q('[data-vx-once-compare]').textContent = oT < full ? fmt(full) : '';
    subOpt.classList.toggle('is-on', state.mode === 'sub');
    subOpt.querySelector('input').checked = (state.mode === 'sub');
    var onceOpt = q('[data-vx-mode-opt="once"]');
    onceOpt.classList.toggle('is-on', state.mode === 'once');
    onceOpt.querySelector('input').checked = (state.mode === 'once');

    // Campos del formulario + botón
    qtyEl.value = n;
    idEl.value = (state.mode === 'sub' && plans[n]) ? idEl.getAttribute('data-sub-id') : idEl.getAttribute('data-once-id');
    if (state.mode === 'sub' && plans[n]) {
      planEl.value = plans[n].id; planEl.disabled = false;
      labelEl.textContent = 'Suscribirme a Voltrix';
      priceEl.textContent = fmt(sT);
      compareEl.textContent = fmt(full); compareEl.style.display = '';
    } else {
      planEl.value = ''; planEl.disabled = true;
      labelEl.textContent = n === 1 ? 'Empezar con Voltrix' : 'Pedir ' + n + ' botes';
      priceEl.textContent = fmt(oT);
      if (oT < full) { compareEl.textContent = fmt(full); compareEl.style.display = ''; } else { compareEl.style.display = 'none'; }
    }
    if (animate) bump(priceEl);
  }

  form.addEventListener('change', function (e) {
    var t = e.target;
    if (!t) return;
    if (t.name === 'vx_pack') { state.n = parseInt(t.value, 10); render(true); }
    if (t.name === 'vx_mode') { state.mode = t.value; render(true); }
  });
  render(false);
})();
</script>
{% endif %}

