{% assign vx_product = all_products['voltrix-daily-performance-formula-30-porciones'] %}

<section class="vx-prod section--dark page-width" id="producto">
  <p class="vx-eyebrow text-volt">El producto</p>
  <h2 class="font-display">Voltrix Daily<br>Performance Formula</h2>

  <div class="vx-cafe">
    <div>
      <div class="vx-cafe__num">1,67€</div>
      <div class="vx-cafe__lbl">Al día</div>
    </div>
    <div class="vx-cafe__div"></div>
    <div>
      <div class="vx-cafe__titulo">Lo que cuesta tu café de las 9.<br>Con mucho más impacto en tu día.</div>
      <div class="vx-cafe__desc">49,99€ al mes son 1,67€ al día. <strong>Lo que te gastas en el café de cada mañana.</strong> Si lo compraras todo por separado pagarías entre 60 y 90€ al mes — y tendrías cuatro botes que olvidarías tomar.</div>
    </div>
  </div>

  <div class="vx-prod__layout">
    <div class="vx-prod__visual">
      {% if vx_product and vx_product.images.size > 0 %}
        <div class="vx-gallery" data-vx-gallery>
          <div class="vx-gallery__main">
            {% if vx_product.images.size > 1 %}
              <button type="button" class="vx-gallery__arrow vx-gallery__arrow--prev" data-vx-prev aria-label="Foto anterior">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
            {% endif %}

            {% for image in vx_product.images %}
              <img
                src="{{ image | image_url: width: 1400 }}"
                alt="{{ image.alt | default: vx_product.title }}"
                class="vx-gallery__img{% if forloop.first %} is-active{% endif %}"
                data-vx-slide="{{ forloop.index0 }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            {% endfor %}

            {% if vx_product.images.size > 1 %}
              <button type="button" class="vx-gallery__arrow vx-gallery__arrow--next" data-vx-next aria-label="Foto siguiente">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
            {% endif %}
          </div>

          {% if vx_product.images.size > 1 %}
            <div class="vx-gallery__thumbs">
              {% for image in vx_product.images %}
                <button
                  type="button"
                  class="vx-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                  data-vx-thumb="{{ forloop.index0 }}"
                  aria-label="Ver foto {{ forloop.index }}"
                >
                  <img src="{{ image | image_url: width: 240 }}" alt="{{ image.alt | default: vx_product.title }}" loading="lazy">
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% elsif section.settings.imagen_producto %}
        {{ section.settings.imagen_producto | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'vx-prod__img' }}
      {% else %}
        <div class="vx-prod__placeholder">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <p>Foto del bote pendiente — sustituir aquí</p>
        </div>
      {% endif %}
    </div>

    <div class="vx-price-card vx-reveal">
      <div class="vx-price-glow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>

      <div class="vx-price-row">
        <div class="vx-price-big">
          {% if vx_product %}{{ vx_product.price | money }}{% else %}49,99€{% endif %}
        </div>
        <div class="vx-price-unit">/ 30 porciones</div>
      </div>
      <div class="vx-price-tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        1,67€/día — lo que cuesta tu café de las 9
      </div>
      <div class="vx-bullets">
        <div class="vx-bullet"><span class="vx-bcheck">✓</span> Hidratación real con electrolitos en dosis efectiva</div>
        <div class="vx-bullet"><span class="vx-bcheck">✓</span> Energía sin crash — teanina Suntheanine® + cafeína en ratio 2:1</div>
        <div class="vx-bullet"><span class="vx-bcheck">✓</span> 3g de creatina Creapure® — pureza certificada 99,9%</div>
        <div class="vx-bullet"><span class="vx-bcheck">✓</span> KSM-66® para regular el estrés y el cortisol</div>
        <div class="vx-bullet"><span class="vx-bcheck">✓</span> Sabor limón-lima, sin azúcar</div>
      </div>

      {% if vx_product %}
        {% assign vx_variant = vx_product.variants.first %}
        {% assign vx_once_variant = vx_variant %}
        {% for v in vx_product.variants %}
          {% if v.option1 == 'Suscripción' %}{% assign vx_variant = v %}{% endif %}
          {% if v.option1 == 'Compra única' %}{% assign vx_once_variant = v %}{% endif %}
        {% endfor %}
        {% form 'product', vx_product, id: 'vx-buy-form' %}
          <input type="hidden" name="id" value="{{ vx_variant.id }}" data-vx-id data-sub-id="{{ vx_variant.id }}" data-once-id="{{ vx_once_variant.id }}">
          <input type="hidden" name="quantity" value="2" data-vx-qty>
          <input type="hidden" name="selling_plan" value="" data-vx-plan disabled>

          <div class="vx-pack" data-vx-pack>
            <div class="vx-sel__title">1 · Elige tu pack</div>
            <div class="vx-pack__grid" role="radiogroup" aria-label="Número de botes">
              {% for n in (1..3) %}
                <label class="vx-pack__opt" data-vx-pack-opt="{{ n }}">
                  <input type="radio" name="vx_pack" value="{{ n }}"{% if n == 2 %} checked{% endif %}>
                  {% if n == 3 %}<span class="vx-pack__flag">Mejor precio por bote</span>{% endif %}
                  <span class="vx-pack__n">{{ n }} {% if n == 1 %}bote{% else %}botes{% endif %}</span>
                  <span class="vx-pack__d">{{ n | times: 30 }} días</span>
                  <span class="vx-pack__u" data-vx-unit="{{ n }}"></span>
                  <span class="vx-pack__save" data-vx-save="{{ n }}"></span>
                </label>
              {% endfor %}
            </div>
          </div>

          <div class="vx-mode" data-vx-mode-wrap>
            <div class="vx-sel__title">2 · Cómo quieres recibirlo</div>
            <label class="vx-mode__opt is-on" data-vx-mode-opt="sub">
              <input type="radio" name="vx_mode" value="sub" checked>
              <span class="vx-mode__head">
                <span class="vx-mode__name">Suscríbete y ahorra <em>Recomendado</em> <em class="vx-mode__extra" data-vx-extra hidden></em></span>
                <span class="vx-mode__price"><s data-vx-sub-compare></s> <b data-vx-sub-price></b></span>
              </span>
              <span class="vx-mode__detail">
                <span>✓ Entrega automática <b data-vx-freq></b></span>
                <span>✓ Pausa, salta o cancela cuando quieras</span>
                <span>✓ Envío gratis</span>
              </span>
            </label>
            <label class="vx-mode__opt" data-vx-mode-opt="once">
              <input type="radio" name="vx_mode" value="once">
              <span class="vx-mode__head">
                <span class="vx-mode__name">Compra única <em class="vx-mode__extra" data-vx-once-tag hidden></em></span>
                <span class="vx-mode__price"><s data-vx-once-compare></s> <b data-vx-once-price></b></span>
              </span>
            </label>
          </div>

          <button type="submit" class="vx-btn-add" data-vx-buy-btn {% unless vx_product.available %}disabled{% endunless %}>
            {% if vx_product.available %}
              <span data-vx-btn-label>Suscribirme a Voltrix</span> —
              <span data-vx-btn-compare class="vx-btn-add__compare" style="display:none;"></span>
              <span data-vx-btn-price>{{ vx_product.price | money }}</span> →
            {% else %}
              Próximamente
            {% endif %}
          </button>
        {% endform %}
      {% else %}
        <button class="vx-btn-add" disabled>Próximamente</button>
      {% endif %}

      <div class="vx-trust">
        <div class="vx-trust__item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          <span>Pago 100% seguro</span>
        </div>
        <div class="vx-trust__item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Envío gratis</span>
        </div>
        <div class="vx-trust__item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Entrega en 2–4 días</span>
        </div>
        <div class="vx-trust__item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>Garantía de 30 días</span>
        </div>
      </div>

      <details class="vx-sub-detail">
        <summary>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
          Detalles de la suscripción
        </summary>
        <p><strong>Control total sobre tu suscripción.</strong> Pausa, reprograma, edita o cancela tus envíos cuando quieras, sin compromiso ni permanencia.</p>
      </details>

      <div class="vx-garantia">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Envío incluido · Suscripción cancelable cuando quieras
      </div>
    </div>
  </div>
</section>
<style>
  .vx-prod { padding: 88px 24px; }
  .vx-prod h2 { font-size: clamp(28px, 3.8vw, 48px); line-height: 1.1; letter-spacing: -.4px; margin-bottom: 32px; }
  .vx-cafe { background: #141430; border: 1px solid #28284A; border-left: 3px solid var(--color-volt); border-radius: 14px; padding: 26px 30px; display: flex; align-items: center; gap: 26px; margin-bottom: 56px; flex-wrap: wrap; }
  .vx-cafe__num { font-family: var(--font-display); font-size: 50px; color: var(--color-volt); line-height: 1; }
  .vx-cafe__lbl { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,.3); margin-top: 3px; }
  .vx-cafe__div { width: 1px; height: 56px; background: #28284A; flex-shrink: 0; }
  .vx-cafe__titulo { font-size: 17px; font-weight: 800; color: var(--color-white); margin-bottom: 5px; line-height: 1.3; }
  .vx-cafe__desc { font-size: 13px; color: rgba(255,255,255,.5); line-height: 1.65; }
  .vx-cafe__desc strong { color: var(--color-white); font-weight: 700; }
  .vx-prod__layout { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .vx-prod__visual { display: flex; align-items: center; justify-content: center; }
  .vx-prod__img { border-radius: 16px; width: 100%; }
  .vx-prod__placeholder {
    width: 100%; aspect-ratio: 1; border: 2px dashed #28284A; border-radius: 16px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    color: rgba(255,255,255,.25); background: rgba(255,255,255,.02);
  }
  .vx-prod__placeholder p { font-size: 12px; text-align: center; max-width: 180px; }

  /* ── Galería ── */
  .vx-gallery { width: 100%; }
  .vx-gallery__main { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 1; background: #0F0F24; }
  .vx-gallery__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity .3s ease; pointer-events: none; }
  .vx-gallery__img.is-active { opacity: 1; pointer-events: auto; }
  .vx-gallery__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: 36px; height: 36px; border-radius: 50%; border: none; cursor: pointer;
    background: rgba(10,10,26,.6); color: #fff; display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(4px); transition: background .15s ease;
  }
  .vx-gallery__arrow:hover { background: rgba(200,241,53,.85); color: #0A0A1A; }
  .vx-gallery__arrow--prev { left: 12px; }
  .vx-gallery__arrow--next { right: 12px; }
  .vx-gallery__thumbs { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .vx-gallery__thumb {
    width: 56px; height: 56px; border-radius: 8px; overflow: hidden; padding: 0; cursor: pointer;
    border: 2px solid transparent; opacity: .5; transition: opacity .15s ease, border-color .15s ease; flex-shrink: 0;
  }
  .vx-gallery__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .vx-gallery__thumb.is-active { opacity: 1; border-color: var(--color-volt); }
  .vx-gallery__thumb:hover { opacity: .85; }

  /* ── Tarjeta de precio, estilo "web animada" ── */
  .vx-price-card {
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.12); border-radius: 20px;
    padding: 34px 32px;
  }
  .vx-price-glow {
    width: 64px; height: 64px; border-radius: 50%;
    background: radial-gradient(circle, rgba(200,241,53,.18), transparent 70%);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 18px;
  }
  .vx-price-glow svg { width: 28px; height: 28px; color: var(--color-volt); filter: drop-shadow(0 0 6px rgba(200,241,53,.6)); }

  .vx-price-row { display: flex; align-items: baseline; gap: 9px; margin-bottom: 5px; }
  .vx-price-big { font-family: var(--font-display); font-size: 46px; color: var(--color-white); line-height: 1; }
  .vx-price-unit { font-size: 14px; color: rgba(255,255,255,.3); }
  .vx-price-tag { display: inline-flex; align-items: center; gap: 7px; background: rgba(200,241,53,.08); border: 1px solid rgba(200,241,53,.2); border-radius: 8px; padding: 6px 13px; margin: 12px 0 22px; font-size: 12px; font-weight: 700; color: var(--color-volt); }
  .vx-bullets { display: flex; flex-direction: column; gap: 9px; margin-bottom: 24px; }
  .vx-subscription-slot:empty { display: none; }
  .vx-subscription-slot:not(:empty) { margin-bottom: 20px; }
  .vx-bullet { display: flex; align-items: center; gap: 11px; font-size: 14px; color: rgba(255,255,255,.55); font-weight: 500; }
  .vx-bcheck { width: 19px; height: 19px; border-radius: 5px; background: rgba(200,241,53,.08); border: 1px solid rgba(200,241,53,.2); color: var(--color-volt); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 11px; }
  .vx-btn-add { display: block; text-align: center; width: 100%; padding: 16px; background: var(--color-volt); color: var(--color-ink); font-family: var(--font-body); font-size: 15px; font-weight: 900; border-radius: 12px; margin-bottom: 11px; border: none; cursor: pointer; position: relative; animation: vx-btn-pulse 2.6s ease-in-out infinite; }
  .vx-btn-add:disabled { opacity: .5; cursor: not-allowed; animation: none; }
  @keyframes vx-btn-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(200,241,53,.45); }
    50% { box-shadow: 0 0 0 10px rgba(200,241,53,0); }
  }
  @media (prefers-reduced-motion: reduce) { .vx-btn-add { animation: none; } }
  .vx-btn-add__compare { text-decoration: line-through; opacity: .55; font-weight: 700; margin-right: 4px; }

  .vx-trust { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px; }
  .vx-trust__item {
    display: flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.03); border: 1px solid #1E1E38; border-radius: 10px;
    padding: 10px 12px; font-size: 11.5px; font-weight: 600; color: rgba(255,255,255,.55);
  }
  .vx-trust__item svg { color: var(--color-volt); flex-shrink: 0; }
  @media (max-width: 480px) { .vx-trust { grid-template-columns: 1fr; } }
  .vx-garantia { display: flex; align-items: center; gap: 6px; font-size: 12px; color: rgba(255,255,255,.3); justify-content: center; text-align: center; }
  .vx-garantia svg { color: var(--color-volt); flex-shrink: 0; }

  .vx-sub-detail { border: 1px solid #28284A; border-radius: 10px; padding: 12px 16px; margin-bottom: 14px; }
  .vx-sub-detail summary {
    display: flex; align-items: center; gap: 9px; cursor: pointer;
    font-size: 13px; font-weight: 700; color: rgba(255,255,255,.75); list-style: none;
  }
  .vx-sub-detail summary::-webkit-details-marker { display: none; }
  .vx-sub-detail summary svg { color: var(--color-volt); flex-shrink: 0; }
  .vx-sub-detail p { font-size: 12.5px; color: rgba(255,255,255,.5); line-height: 1.6; margin-top: 10px; padding-left: 25px; }
  .vx-sub-detail p strong { color: var(--color-white); }

  /* ── Selector de packs + modo de compra ── */
  .vx-sel__title { font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,.4); margin-bottom: 10px; }
  .vx-pack { margin-bottom: 20px; }
  .vx-pack__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .vx-pack__opt, .vx-mode__opt { position: relative; cursor: pointer; display: block; }
  .vx-pack__opt input, .vx-mode__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .vx-pack__opt {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 2px;
    padding: 20px 6px 12px; border-radius: 12px; border: 1px solid #28284A; background: rgba(255,255,255,.03);
    transition: border-color .2s ease, background .2s ease, transform .2s ease;
  }
  .vx-pack__opt:hover { border-color: rgba(200,241,53,.4); }
  .vx-pack__opt.is-on { border-color: var(--color-volt); background: rgba(200,241,53,.08); box-shadow: 0 0 0 1px var(--color-volt) inset; }
  .vx-pack__opt:has(input:focus-visible), .vx-mode__opt:has(input:focus-visible) { outline: 2px solid var(--color-volt); outline-offset: 2px; }
  .vx-pack__flag { position: absolute; top: -9px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--color-volt); color: var(--color-ink); font-size: 9px; font-weight: 900; letter-spacing: .3px; text-transform: uppercase; padding: 3px 8px; border-radius: 99px; }
  .vx-pack__n { font-size: 15px; font-weight: 800; color: var(--color-white); }
  .vx-pack__d { font-size: 11px; color: rgba(255,255,255,.4); }
  .vx-pack__u { font-size: 13px; font-weight: 800; color: var(--color-volt); margin-top: 6px; }
  .vx-pack__save { font-size: 10px; white-space: nowrap; font-weight: 800; color: var(--color-ink); background: rgba(200,241,53,.9); border-radius: 99px; padding: 2px 7px; margin-top: 4px; min-height: 17px; }
  .vx-pack__save:empty { visibility: hidden; }
  .vx-mode { margin-bottom: 18px; }
  .vx-mode__opt { border: 1px solid #28284A; border-radius: 12px; padding: 14px 16px; margin-bottom: 8px; background: rgba(255,255,255,.03); transition: border-color .2s ease, background .2s ease; }
  .vx-mode__opt.is-on { border-color: var(--color-volt); background: rgba(200,241,53,.06); }
  .vx-mode__opt.is-off { opacity: .45; cursor: not-allowed; }
  .vx-mode__head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .vx-mode__name { font-size: 14.5px; font-weight: 800; color: var(--color-white); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .vx-mode__name::before { content: ''; width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(255,255,255,.3); flex-shrink: 0; transition: all .2s ease; }
  .vx-mode__opt.is-on .vx-mode__name::before { border-color: var(--color-volt); background: radial-gradient(circle, var(--color-volt) 45%, transparent 50%); }
  .vx-mode__name em { font-style: normal; font-size: 10px; font-weight: 900; background: var(--color-white); color: var(--color-ink); border-radius: 99px; padding: 2px 8px; }
  .vx-mode__price { font-size: 17px; color: var(--color-white); }
  .vx-mode__price s { font-size: 12px; color: rgba(255,255,255,.35); margin-right: 4px; }
  .vx-mode__price b { font-weight: 900; }
  .vx-mode__opt.is-on[data-vx-mode-opt="sub"] .vx-mode__price b { color: var(--color-volt); }
  .vx-mode__name em.vx-mode__extra { background: var(--color-volt); color: var(--color-ink); }
  .vx-mode__extra[hidden] { display: none; }
  .vx-mode__detail { display: none; flex-direction: column; gap: 5px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.08); font-size: 12.5px; color: rgba(255,255,255,.55); }
  .vx-mode__opt.is-on[data-vx-mode-opt="sub"] .vx-mode__detail { display: flex; animation: vxFade .3s ease; }
  .vx-mode__detail b { color: var(--color-white); }
  @keyframes vxFade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .vx-bump { animation: vxBump .35s ease; }
  @keyframes vxBump { 50% { transform: scale(1.06); } }
  @media (prefers-reduced-motion: reduce) { .vx-bump, .vx-mode__opt.is-on[data-vx-mode-opt="sub"] .vx-mode__detail { animation: none; } }
  @media (max-width: 420px) { .vx-pack__n { font-size: 14px; } .vx-pack__opt { padding: 20px 4px 12px; } }

  /* ── Reskin del widget de suscripción de Appstle ──
     Especificidad alta a propósito: Appstle inyecta su propio <style>
     con selectores encadenados (.wrapper.compact .option) que ganan
     a reglas de una sola clase incluso con !important. */
  html body .appstle_subscription_wrapper .appstle_subscription_wrapper_option {
    background: rgba(255,255,255,.03) !important;
    border: 1px solid #1E1E38 !important;
    border-radius: 12px !important;
    margin-bottom: 10px !important;
    padding: 14px 16px !important;
  }
  html body .appstle_subscription_wrapper .appstle_subscription_wrapper_option.appstle-active-option,
  html body .appstle_subscription_wrapper .appstle_subscription_wrapper_option.appstle_selected_background {
    background: rgba(200,241,53,.07) !important;
