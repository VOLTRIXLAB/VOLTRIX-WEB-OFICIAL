<section class="vx-eh section--dark page-width" id="unirme">
  <p class="vx-eyebrow text-volt">Lista de espera · Lanzamiento</p>
  <h1 class="font-display">Todo lo que necesitas para rendir cada día.<br><em>En una sola toma.</em></h1>
  <p class="vx-eh__sub">Voltrix Daily Performance Formula todavía no está a la venta. Apúntate hoy y serás de los primeros en poder comprarla, con un <strong>25 % de descuento de lanzamiento</strong> y la <strong>Guía de Rendimiento Diario</strong> gratis.</p>
  <div class="vx-eh__card">
    <ul class="vx-eh__perks">
      <li><span>−25 %</span> en tu primer pedido de lanzamiento <em>(49,99 € → 37,49 €)</em></li>
      <li><span>Guía</span> de Rendimiento Diario: 8 capítulos, gratis al apuntarte</li>
      <li><span>Antes</span> que nadie: aviso por email cuando abramos</li>
    </ul>
    {% render 'vx-espera-form', id: 'hero' %}
  </div>
  <p class="vx-eh__note">Sin compromiso de compra. Un email de bienvenida y el aviso de lanzamiento. Nada de spam.</p>
</section>
<style>
  .vx-sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  .vx-eh { padding: 72px 24px 56px; text-align: center; }
  .vx-eh h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1.08; letter-spacing: -.5px; margin: 6px auto 16px; max-width: 820px; color: var(--color-white); }
  .vx-eh h1 em { font-style: italic; color: var(--color-volt); }
  .vx-eh__sub { font-size: 17px; line-height: 1.7; color: rgba(255,255,255,.75); max-width: 620px; margin: 0 auto 30px; }
  .vx-eh__sub strong { color: var(--color-white); }
  .vx-eh__card { max-width: 560px; margin: 0 auto; background: #141430; border: 1px solid #28284A; border-radius: 20px; padding: 28px; text-align: left; }
  .vx-eh__perks { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 12px; }
  .vx-eh__perks li { font-size: 14px; line-height: 1.5; color: rgba(255,255,255,.8); display: flex; gap: 12px; align-items: baseline; }
  .vx-eh__perks li span { flex: 0 0 auto; min-width: 52px; font-weight: 800; font-size: 12px; letter-spacing: .5px; text-transform: uppercase; color: var(--color-ink); background: var(--color-volt); border-radius: 6px; padding: 3px 8px; text-align: center; }
  .vx-eh__perks em { color: rgba(255,255,255,.55); font-style: normal; }
  .vx-eh__note { font-size: 12px; color: rgba(255,255,255,.55); margin-top: 16px; }
  .vx-wl__row { display: flex; gap: 8px; }
  .vx-wl__input { flex: 1; min-width: 0; padding: 14px 16px; border-radius: 10px; border: 1px solid #28284A; background: rgba(255,255,255,.05); color: var(--color-white); font-size: 15px; }
  .vx-wl__input::placeholder { color: rgba(255,255,255,.4); }
  .vx-wl__btn { padding: 14px 20px; border-radius: 10px; background: var(--color-volt); color: var(--color-ink); font-weight: 800; font-size: 14px; border: none; cursor: pointer; white-space: nowrap; }
  .vx-wl__btn:disabled { opacity: .6; cursor: not-allowed; }
  .vx-wl__consent { display: flex; gap: 10px; align-items: flex-start; margin-top: 12px; font-size: 12px; line-height: 1.5; color: rgba(255,255,255,.6); cursor: pointer; }
  .vx-wl__consent input { margin-top: 2px; accent-color: #C8F135; flex: 0 0 auto; width: 16px; height: 16px; }
  .vx-wl__consent a { color: var(--color-volt); text-decoration: underline; }
  .vx-wl__msg { font-size: 13px; margin-top: 12px; line-height: 1.5; }
  .vx-wl__msg--err { color: #F87171; }
  .vx-wl__msg--ok { color: var(--color-volt); font-weight: 700; }
  @media (max-width: 560px) { .vx-eh { padding: 48px 16px 40px; } .vx-eh__card { padding: 22px 18px; } .vx-wl__row { flex-direction: column; } .vx-wl__btn { width: 100%; } }
</style>
<script>
(function () {
  var COMPANY = 'UzyR6k', LIST = 'RcP3p8';
  document.querySelectorAll('[data-vx-wl]').forEach(function (form) {
    var email = form.querySelector('[data-vx-wl-email]');
    var consent = form.querySelector('[data-vx-wl-consent]');
    var btn = form.querySelector('[data-vx-wl-btn]');
    var err = form.querySelector('[data-vx-wl-err]');
    var ok = form.querySelector('[data-vx-wl-ok]');
    var label = btn.textContent;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      err.hidden = true;
      if (!email.value || !/^\S+@\S+\.\S+$/.test(email.value)) { err.textContent = 'Revisa tu email: no parece válido.'; err.hidden = false; return; }
      if (!consent.checked) { err.textContent = 'Marca la casilla para poder enviarte la guía y el descuento.'; err.hidden = false; return; }
      btn.disabled = true; btn.textContent = 'Enviando…';
      fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + COMPANY, {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'revision': '2026-07-15' },
        body: JSON.stringify({ data: { type: 'subscription',
          attributes: { profile: { data: { type: 'profile', attributes: { email: email.value, properties: { fuente: 'lista-espera', oferta: 'lanzamiento-25' } } } } },
          relationships: { list: { data: { type: 'list', id: LIST } } } } })
      }).then(function (res) {
        if (!res.ok && res.status !== 202) throw new Error('klaviyo');
        document.querySelectorAll('[data-vx-wl]').forEach(function (f) {
          f.querySelector('.vx-wl__row').hidden = true;
          f.querySelector('.vx-wl__consent').hidden = true;
          f.querySelector('[data-vx-wl-err]').hidden = true;
          f.querySelector('[data-vx-wl-ok]').hidden = false;
        });
      }).catch(function () {
        err.textContent = 'Ha habido un error. Inténtalo de nuevo en un momento.'; err.hidden = false;
        btn.disabled = false; btn.textContent = label;
      });
    });
  });
})();
</script>
{% schema %}
{ "name": "Espera · Cabecera", "settings": [] }
{% endschema %}
