<form class="vx-wl" data-vx-wl novalidate>
  <div class="vx-wl__row">
    <label class="vx-sr" for="vx-wl-{{ id }}">Tu email</label>
    <input type="email" id="vx-wl-{{ id }}" name="email" placeholder="tu@email.com" autocomplete="email" required class="vx-wl__input" data-vx-wl-email>
    <button type="submit" class="vx-wl__btn" data-vx-wl-btn>{{ btn | default: 'Quiero mi 25 % y la guía →' }}</button>
  </div>
  <label class="vx-wl__consent">
    <input type="checkbox" name="consent" required data-vx-wl-consent>
    <span>Acepto recibir emails de Voltrix (la guía, mi descuento y el aviso de lanzamiento). Puedes darte de baja cuando quieras. <a href="/pages/politicas#privacidad">Política de privacidad</a>.</span>
  </label>
  <p class="vx-wl__msg vx-wl__msg--err" data-vx-wl-err role="alert" hidden></p>
  <p class="vx-wl__msg vx-wl__msg--ok" data-vx-wl-ok role="status" hidden>¡Estás dentro! Revisa tu email: ahí van tu guía y tu 25 %. Si no lo ves en unos minutos, mira en promociones o spam.</p>
</form>
